---
// The official 5-square dPLaaX mark as a decorative watermark.
// Color comes from currentColor: control tint/opacity via text-* classes on
// the caller (e.g. `text-fg-strong/5` on light, `text-fg-inverse/10` on the
// inverse band) and keep it faint — it is background, not content.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  viewBox="0 0 72.9 113"
  class={className}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
>
  <rect x="40" width="32.9" height="32.9"></rect>
  <rect x="40" y="80" width="32.9" height="32.9"></rect>
  <rect y="80.1" width="32.9" height="32.9"></rect>
  <rect y="40.1" width="32.9" height="32.9"></rect>
  <rect x="39.9" y="40.1" width="32.9" height="32.9"></rect>
</svg>
