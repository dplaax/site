---
import { t, type Locale } from '~/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<figure class="border-border-subtle bg-bg-elev-1 rounded-xl border p-5 md:p-7">
  <svg
    viewBox="0 0 960 260"
    role="img"
    aria-label={t(locale, 'line.diagramLabel')}
    class="hidden w-full md:block"
  >
    <!-- Organization A -->
    <rect
      x="30"
      y="20"
      width="220"
      height="210"
      rx="14"
      fill="var(--color-bg-base)"
      stroke="var(--color-border-strong)"
      stroke-width="1.5"></rect>
    <text x="50" y="54" fill="var(--color-fg-strong)" font-size="16" font-weight="600"
      >{t(locale, 'line.orgA')}</text
    >
    <rect
      x="50"
      y="76"
      width="180"
      height="88"
      rx="10"
      fill="var(--color-bg-elev-1)"
      stroke="var(--color-accent-blue)"
      stroke-width="1.5"></rect>
    <text
      x="140"
      y="111"
      fill="var(--color-fg-strong)"
      font-size="14"
      font-weight="600"
      text-anchor="middle">{t(locale, 'line.record1')}</text
    >
    <text
      x="140"
      y="140"
      fill="var(--color-fg-muted)"
      font-family="var(--font-mono)"
      font-size="11"
      text-anchor="middle">{t(locale, 'line.outputDigest')}</text
    >

    <!-- Link from record 01 to record 02 -->
    <line x1="250" y1="120" x2="370" y2="120" stroke="var(--color-accent-blue)" stroke-width="2"
    ></line>
    <path d="M370 120 L358 113 L358 127 Z" fill="var(--color-accent-blue)"></path>
    <text
      x="310"
      y="101"
      fill="var(--color-fg-muted)"
      font-family="var(--font-mono)"
      font-size="10"
      text-anchor="middle">previousCredential</text
    >
    <text
      x="310"
      y="146"
      fill="var(--color-accent-blue)"
      font-family="var(--font-mono)"
      font-size="10"
      text-anchor="middle">H1 = H1</text
    >

    <!-- Organization B -->
    <rect
      x="370"
      y="20"
      width="220"
      height="210"
      rx="14"
      fill="var(--color-bg-base)"
      stroke="var(--color-border-strong)"
      stroke-width="1.5"></rect>
    <text x="390" y="54" fill="var(--color-fg-strong)" font-size="16" font-weight="600"
      >{t(locale, 'line.orgB')}</text
    >
    <rect
      x="390"
      y="76"
      width="180"
      height="88"
      rx="10"
      fill="var(--color-bg-elev-1)"
      stroke="var(--color-accent-violet)"
      stroke-width="1.5"></rect>
    <text
      x="480"
      y="111"
      fill="var(--color-fg-strong)"
      font-size="14"
      font-weight="600"
      text-anchor="middle">{t(locale, 'line.record2')}</text
    >
    <text
      x="480"
      y="140"
      fill="var(--color-fg-muted)"
      font-family="var(--font-mono)"
      font-size="10"
      text-anchor="middle">{t(locale, 'line.linkedDigest')}</text
    >
    <rect x="404" y="182" width="152" height="28" rx="14" fill="var(--color-bg-elev-2)"></rect>
    <text x="480" y="201" fill="var(--color-fg-muted)" font-size="11" text-anchor="middle"
      >{t(locale, 'line.retained')}</text
    >

    <!-- Linked evidence reaches the recipient -->
    <line x1="590" y1="120" x2="710" y2="120" stroke="var(--color-accent-blue)" stroke-width="2"
    ></line>
    <path d="M710 120 L698 113 L698 127 Z" fill="var(--color-accent-blue)"></path>

    <!-- Recipient verifies before acting -->
    <rect
      x="710"
      y="20"
      width="220"
      height="210"
      rx="14"
      fill="var(--color-bg-base)"
      stroke="var(--color-accent-blue)"
      stroke-width="1.5"></rect>
    <text x="730" y="54" fill="var(--color-fg-strong)" font-size="16" font-weight="600"
      >{t(locale, 'line.recipient')}</text
    >
    <rect x="730" y="76" width="180" height="48" rx="10" fill="var(--color-bg-elev-1)"></rect>
    <text
      x="820"
      y="105"
      fill="var(--color-fg-strong)"
      font-size="12"
      font-weight="600"
      text-anchor="middle">{t(locale, 'line.verify')}</text
    >
    <text x="820" y="150" fill="var(--color-fg-muted)" font-size="11" text-anchor="middle"
      >{t(locale, 'line.policy')}</text
    >
    <text
      x="820"
      y="174"
      fill="var(--color-accent-blue)"
      font-family="var(--font-mono)"
      font-size="10"
      font-weight="600"
      text-anchor="middle">{t(locale, 'line.result')}</text
    >
    <rect x="744" y="190" width="152" height="28" rx="14" fill="var(--color-bg-elev-2)"></rect>
    <text x="820" y="209" fill="var(--color-fg-muted)" font-size="11" text-anchor="middle"
      >{t(locale, 'line.retained')}</text
    >
  </svg>

  <svg
    viewBox="0 0 360 680"
    role="img"
    aria-label={t(locale, 'line.diagramLabel')}
    class="w-full md:hidden"
  >
    <!-- Organization A -->
    <rect
      x="20"
      y="20"
      width="320"
      height="150"
      rx="14"
      fill="var(--color-bg-base)"
      stroke="var(--color-border-strong)"
      stroke-width="1.5"></rect>
    <text x="40" y="54" fill="var(--color-fg-strong)" font-size="16" font-weight="600"
      >{t(locale, 'line.orgA')}</text
    >
    <rect
      x="40"
      y="74"
      width="280"
      height="76"
      rx="10"
      fill="var(--color-bg-elev-1)"
      stroke="var(--color-accent-blue)"
      stroke-width="1.5"></rect>
    <text
      x="180"
      y="104"
      fill="var(--color-fg-strong)"
      font-size="14"
      font-weight="600"
      text-anchor="middle">{t(locale, 'line.record1')}</text
    >
    <text
      x="180"
      y="130"
      fill="var(--color-fg-muted)"
      font-family="var(--font-mono)"
      font-size="11"
      text-anchor="middle">{t(locale, 'line.outputDigest')}</text
    >

    <!-- Link from record 01 to record 02 -->
    <line x1="180" y1="170" x2="180" y2="230" stroke="var(--color-accent-blue)" stroke-width="2"
    ></line>
    <path d="M180 230 L173 218 L187 218 Z" fill="var(--color-accent-blue)"></path>
    <text x="194" y="194" fill="var(--color-fg-muted)" font-family="var(--font-mono)" font-size="10"
      >previousCredential</text
    >
    <text
      x="194"
      y="216"
      fill="var(--color-accent-blue)"
      font-family="var(--font-mono)"
      font-size="10">H1 = H1</text
    >

    <!-- Organization B -->
    <rect
      x="20"
      y="230"
      width="320"
      height="180"
      rx="14"
      fill="var(--color-bg-base)"
      stroke="var(--color-border-strong)"
      stroke-width="1.5"></rect>
    <text x="40" y="264" fill="var(--color-fg-strong)" font-size="16" font-weight="600"
      >{t(locale, 'line.orgB')}</text
    >
    <rect
      x="40"
      y="284"
      width="280"
      height="76"
      rx="10"
      fill="var(--color-bg-elev-1)"
      stroke="var(--color-accent-violet)"
      stroke-width="1.5"></rect>
    <text
      x="180"
      y="314"
      fill="var(--color-fg-strong)"
      font-size="14"
      font-weight="600"
      text-anchor="middle">{t(locale, 'line.record2')}</text
    >
    <text
      x="180"
      y="340"
      fill="var(--color-fg-muted)"
      font-family="var(--font-mono)"
      font-size="10"
      text-anchor="middle">{t(locale, 'line.linkedDigest')}</text
    >
    <rect x="104" y="372" width="152" height="26" rx="13" fill="var(--color-bg-elev-2)"></rect>
    <text x="180" y="390" fill="var(--color-fg-muted)" font-size="11" text-anchor="middle"
      >{t(locale, 'line.retained')}</text
    >

    <!-- Linked evidence reaches the recipient -->
    <line x1="180" y1="410" x2="180" y2="450" stroke="var(--color-accent-blue)" stroke-width="2"
    ></line>
    <path d="M180 450 L173 438 L187 438 Z" fill="var(--color-accent-blue)"></path>

    <!-- Recipient verifies before acting -->
    <rect
      x="20"
      y="450"
      width="320"
      height="210"
      rx="14"
      fill="var(--color-bg-base)"
      stroke="var(--color-accent-blue)"
      stroke-width="1.5"></rect>
    <text x="40" y="484" fill="var(--color-fg-strong)" font-size="16" font-weight="600"
      >{t(locale, 'line.recipient')}</text
    >
    <rect x="40" y="504" width="280" height="48" rx="10" fill="var(--color-bg-elev-1)"></rect>
    <text
      x="180"
      y="533"
      fill="var(--color-fg-strong)"
      font-size="12"
      font-weight="600"
      text-anchor="middle">{t(locale, 'line.verify')}</text
    >
    <text x="180" y="581" fill="var(--color-fg-muted)" font-size="11" text-anchor="middle"
      >{t(locale, 'line.policy')}</text
    >
    <text
      x="180"
      y="605"
      fill="var(--color-accent-blue)"
      font-family="var(--font-mono)"
      font-size="10"
      font-weight="600"
      text-anchor="middle">{t(locale, 'line.result')}</text
    >
    <rect x="104" y="620" width="152" height="26" rx="13" fill="var(--color-bg-elev-2)"></rect>
    <text x="180" y="638" fill="var(--color-fg-muted)" font-size="11" text-anchor="middle"
      >{t(locale, 'line.retained')}</text
    >
  </svg>

  <figcaption
    class="text-fg-muted mt-4 flex flex-wrap items-center justify-center gap-x-2 text-center font-mono text-xs"
  >
    <span>{t(locale, 'line.link')}</span>
    <span aria-hidden="true">·</span>
    <span>{t(locale, 'line.retained')}</span>
  </figcaption>
</figure>
