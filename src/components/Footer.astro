---
import { t, type Locale } from '~/i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<footer class="border-border-subtle bg-bg-elev-1 mt-12 border-t py-12">
  <div
    class="container-page flex flex-col items-start justify-between gap-6 md:flex-row md:items-center"
  >
    <div>
      <img src="/logo.svg" alt="dPLaaX" class="h-5 w-auto" />
      <p class="text-fg-muted mt-2 text-xs">{t(locale, 'footer.tagline')}</p>
    </div>
    <div class="text-fg-muted flex flex-col gap-1 text-xs md:items-end">
      <p>{t(locale, 'footer.copyright')}</p>
    </div>
  </div>
</footer>
