---
import { t, type Locale } from '~/i18n/ui';
import { localizedPath } from '~/i18n/utils';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<footer class="bg-bg-inverse mt-12 py-12">
  <div
    class="container-page flex flex-col items-start justify-between gap-6 md:flex-row md:items-center"
  >
    <div>
      <img src="/logo-white.svg" alt="dPLaaX" class="h-5 w-auto" />
      <p class="text-fg-inverse-muted mt-2 text-xs">{t(locale, 'footer.tagline')}</p>
    </div>
    <div class="text-fg-inverse-muted flex flex-col gap-1 text-xs md:items-end">
      <a href={localizedPath(locale, '/privacy')} class="hover:text-fg-inverse">
        {t(locale, 'footer.privacy')}
      </a>
      <p>{t(locale, 'footer.copyright')}</p>
    </div>
  </div>
</footer>
