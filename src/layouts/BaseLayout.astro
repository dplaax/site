---
import '~/styles/global.css';
import { t, type Locale } from '~/i18n/ui';
import { alternatePath, otherLocale } from '~/i18n/utils';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
}

const { locale, title, description } = Astro.props;
const pathname = Astro.url.pathname;
const pageTitle = title ?? t(locale, 'site.title');
const pageDesc = description ?? t(locale, 'site.description');
const altHref = new URL(alternatePath(locale, pathname), Astro.site ?? Astro.url).toString();
const selfHref = new URL(pathname, Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={selfHref} />
    <link rel="alternate" hreflang={locale} href={selfHref} />
    <link rel="alternate" hreflang={otherLocale(locale)} href={altHref} />
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL('/', Astro.site ?? Astro.url).toString()}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={selfHref} />
    <meta property="og:locale" content={locale === 'ja' ? 'ja_JP' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <Header locale={locale} pathname={pathname} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      const els = document.querySelectorAll('.reveal');
      const motion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (motion || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 },
        );
        // Reveal anything already in the viewport on first paint, then observe the rest.
        const vh = window.innerHeight;
        els.forEach((el) => {
          const rect = el.getBoundingClientRect();
          if (rect.top < vh && rect.bottom > 0) {
            el.classList.add('is-visible');
          } else {
            io.observe(el);
          }
        });
      }
    </script>
  </body>
</html>
